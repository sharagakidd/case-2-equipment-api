PORT=3000
NODE_ENV=development
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
LOG_LEVEL=info
WEATHER_API_URL=https://geocoding-api.open-meteo.com/v1/search
FORECAST_API_URL=https://api.open-meteo.com/v1/forecast
REQUEST_TIMEOUT_MS=5000
MAX_WIND_SPEED=10
MAX_PRECIPITATION=0
POSTGRES_DB=equipment_api
POSTGRES_USER=app
POSTGRES_PASSWORD=
PGHOST=localhost
PGPORT=5432
PGDATABASE=equipment_api
PGUSER=app
PGPASSWORD=

# JWT: в репозитории секретов нет — значения задаются локально длинными случайными строками
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Лимит попыток входа (по умолчанию 5 попыток за 15 минут)
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=5

# Администратор Grafana (локальный вход на http://localhost:3001).
# Если не задать — подставится admin/admin.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
